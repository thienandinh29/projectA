# NOTE: gitignore patterns do NOT support quoting. The previous version of
# this file wrapped every pattern in literal double quotes ("*.pyc"), so none
# of them ever matched anything — which is how 21 .pyc binaries got tracked
# (round-5 review). Keep patterns bare.
__pycache__/
*.pyc
.env
!.env.example
data/delivery-outbox.sqlite3*
data/week3-test-results.txt
data/week3-focused-results.txt
*.duckdb.before-v*.bak
data/storage-validation/
