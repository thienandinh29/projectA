# Redpanda / Kafka Broker Settings
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Redis Cache Settings
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_TTL_SECONDS=604800  # 7 Days in seconds (7 * 24 * 3600)

# Redpanda Topic Names
TOPIC_RSS=financial.news.rss
TOPIC_GDELT=financial.news.gdelt
TOPIC_SEC=financial.filings.sec

# SEC EDGAR Settings
# Note: SEC strictly requires User-Agent in format: Sample Company Name AdminContact@<sample company domain>.com
SEC_USER_AGENT=FinancialPipeline research@example.com
SEC_MAX_REQUESTS_PER_SECOND=8

# Polling Interval Settings (in seconds)
RSS_POLL_INTERVAL_SECONDS=180     # 3 minutes
GDELT_POLL_INTERVAL_SECONDS=900   # 15 minutes
SEC_POLL_INTERVAL_SECONDS=300     # 5 minutes
